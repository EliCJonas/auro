#!/bin/bash

VERSION="1.5.0"
PROGRAM_NAME="auro"

# Check for root/sudo access
if [[ $EUID -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

# Get the real user's home directory (not root's)
if [[ -n "$SUDO_USER" ]]; then
    REAL_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
else
    REAL_HOME="$HOME"
fi

# Colors for output (bright variants)
RED='\033[0;91m'
GREEN='\033[0;92m'
YELLOW='\033[0;93m'
BLUE='\033[0;94m'
NC='\033[0m' # No Color

DATA="$REAL_HOME/.keg/data"
BIN="$REAL_HOME/.keg/bin"
LIB="/usr/local/lib/"
INSTALLED="$REAL_HOME/.keg/installed"
DESKTOP="$REAL_HOME/.local/share/applications"
ICONS="$REAL_HOME/.local/share/icons/hicolor/256x256/apps"

# Repository configuration
CONFIG_FILE="$REAL_HOME/.keg/repositories.conf"
DEFAULT_REPO_NAME="default"

# Print colored messages
print_error() {
    echo -e "${RED}Error: $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}$1${NC}"
}

print_info() {
    echo -e "${BLUE}$1${NC}"
}

print_warning() {
    echo -e "${YELLOW}$1${NC}"
}

# Help command
cmd_help() {
    echo -e "${GREEN}"
    cat << 'EOF'
         *  .  *       .        *    .   *
      .    *      _____     *        .
   *    .      /|      |\       .   *   .
     .    *   / | * .  | \   *    .
    *   .  * /  |  *   |  \    *    .   *
   . *     /    |.   * |   \      *   .
     .  *  ~~~~~| AURO |~~~~~   .    *
   *    .      *|   *  |  .   *   .
      .   *  .  |*   . | *   .   *    .
    *   .    *  | .  * |   .   *
       *   .    |  *   |  .   *   .  *
EOF
    echo -e "${NC}"
    echo -e "              ${GREEN}auro v${VERSION}${NC}"
    echo -e "        ${BLUE}A simple package manager${NC}"
    echo ""
    echo -e "${YELLOW}Usage:${NC} $PROGRAM_NAME <command> [options] [packages...]"
    echo ""
    echo -e "${YELLOW}Commands:${NC}"
    echo -e "  ${GREEN}install${NC} <file.keg...>  Install one or more .keg packages"
    echo -e "  ${GREEN}remove${NC} <package...>    Remove installed packages"
    echo -e "  ${GREEN}get${NC} <url...>           Download and install from URL"
    echo -e "  ${GREEN}load${NC} <file.ikeg...>    Install from an .ikeg descriptor"
    echo -e "  ${GREEN}repo${NC} <package...>      Install from the remote repository"
    echo -e "  ${GREEN}add-repo${NC} <name> <url>      Add a repository"
    echo -e "  ${GREEN}remove-repo${NC} <name>         Remove a repository"
    echo -e "  ${GREEN}fixperms${NC}                   Fix permissions on the .keg directory"
    echo -e "  ${GREEN}list${NC}                       List installed packages"
    echo -e "  ${GREEN}help${NC}                   Show this help message"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo -e "  $PROGRAM_NAME install myapp.keg"
    echo -e "  $PROGRAM_NAME get https://example.com/app.keg"
    echo ""
}

# Install command
cmd_install() {
    if [[ $# -eq 0 ]]; then
        print_error "No .keg file specified"
        echo "Usage: $PROGRAM_NAME install <file.keg...>"
        return 1
    fi

    for kegfile in "$@"; do
        # Check if file exists
        if [[ ! -f "$kegfile" ]]; then
            print_error "File not found: $kegfile"
            continue
        fi

        # Check if it's a .keg file
        if [[ "$kegfile" != *.keg ]]; then
            print_warning "File does not have .keg extension: $kegfile"
        fi

        print_info "Installing $kegfile..."

        # Create temp directory for extraction
        local temp_dir=$(mktemp -d)

        # Unzip the .keg file
        if ! unzip -q "$kegfile" -d "$temp_dir"; then
            print_error "Failed to extract $kegfile"
            rm -rf "$temp_dir"
            continue
        fi

        # Find the package root (handles top-level folder from zip)
        local pkg_root="$temp_dir"
        if [[ -f "$temp_dir/keg-name.txt" ]]; then
            pkg_root="$temp_dir"
        else
            # Look for keg-name.txt in a subdirectory
            local found_root=$(find "$temp_dir" -name "keg-name.txt" -printf '%h\n' | head -1)
            if [[ -n "$found_root" ]]; then
                pkg_root="$found_root"
            fi
        fi

        # Get package name
        local pkg_name
        if [[ -f "$pkg_root/keg-name.txt" ]]; then
            pkg_name=$(cat "$pkg_root/keg-name.txt")
        else
            pkg_name=$(basename "$kegfile" .keg)
        fi

        # Prepare to track installed files
        local bin_name=$(echo "$pkg_name" | tr '[:upper:]' '[:lower:]')

        # Ensure directories exist (remove file if it conflicts)
        for dir in "$INSTALLED" "$DATA" "$BIN"; do
            if [[ -f "$dir" ]]; then
                rm -f "$dir"
            fi
            mkdir -p "$dir"
        done

        local manifest="$INSTALLED/$bin_name.txt"
        > "$manifest"  # Clear/create manifest

        # Move data files to $DATA
        if [[ -d "$pkg_root/data" ]]; then
            for file in "$pkg_root/data/"*; do
                if [[ -e "$file" ]]; then
                    local basename=$(basename "$file")
                    cp -r "$file" "$DATA/"
                    echo "$DATA/$basename" >> "$manifest"
                fi
            done
        fi

        # Move library files to $LIB
        if [[ -d "$pkg_root/lib" ]]; then
            for file in "$pkg_root/lib/"*; do
                if [[ -e "$file" ]]; then
                    local basename=$(basename "$file")
                    cp -r "$file" "$LIB/"
                    echo "$LIB/$basename" >> "$manifest"
                fi
            done
        fi

        # Move root files (except keg-name.txt) to $BIN
        for file in "$pkg_root/"*; do
            local basename=$(basename "$file")
            # Skip known directories and keg-name.txt
            [[ -d "$file" ]] && continue
            [[ "$basename" == "keg-name.txt" ]] && continue
            cp "$file" "$BIN/$basename"
            chmod +x "$BIN/$basename"
            echo "$BIN/$basename" >> "$manifest"
            # Symlink to ~/.local/bin for PATH accessibility
            mkdir -p "$REAL_HOME/.local/bin"
            ln -sf "$BIN/$basename" "$REAL_HOME/.local/bin/$basename"
            echo "$REAL_HOME/.local/bin/$basename" >> "$manifest"
            ln -sf "$BIN/$basename" "/usr/local/bin/$basename"
            echo "/usr/local/bin/$basename" >> "$manifest"
        done

        # Move .desktop files to applications directory
        if [[ -d "$pkg_root/desktop" ]]; then
            mkdir -p "$DESKTOP"
            for file in "$pkg_root/desktop/"*; do
                if [[ -e "$file" ]]; then
                    local basename=$(basename "$file")
                    cp "$file" "$DESKTOP/"
                    echo "$DESKTOP/$basename" >> "$manifest"
                fi
            done
        fi

        # Symlink icons to hicolor theme
        if [[ -d "$pkg_root/icons" ]]; then
            mkdir -p "$ICONS"
            for file in "$pkg_root/icons/"*.png; do
                if [[ -e "$file" ]]; then
                    local basename=$(basename "$file")
                    cp "$file" "$DATA/"
                    ln -sf "$DATA/$basename" "$ICONS/$basename"
                    echo "$DATA/$basename" >> "$manifest"
                    echo "$ICONS/$basename" >> "$manifest"
                fi
            done
            gtk-update-icon-cache "$REAL_HOME/.local/share/icons/hicolor" 2>/dev/null
        fi

        # Cleanup temp directory
        rm -rf "$temp_dir"

        print_success "Successfully installed $kegfile"
    done
}

# Remove command
cmd_remove() {
    if [[ $# -eq 0 ]]; then
        print_error "No package specified"
        echo "Usage: $PROGRAM_NAME remove <package...>"
        return 1
    fi

    for pkg_name in "$@"; do
        local bin_name=$(echo "$pkg_name" | tr '[:upper:]' '[:lower:]')
        local manifest="$INSTALLED/$bin_name.txt"

        if [[ ! -f "$manifest" ]]; then
            print_error "Package '$pkg_name' is not installed"
            continue
        fi

        print_info "Removing $pkg_name..."

        # Remove each file listed in the manifest
        while IFS= read -r file; do
            if [[ -e "$file" || -L "$file" ]]; then
                rm -rf "$file"
            fi
        done < "$manifest"

        # Update icon cache if icons were removed
        if grep -q "$ICONS" "$manifest" 2>/dev/null; then
            gtk-update-icon-cache "$REAL_HOME/.local/share/icons/hicolor" 2>/dev/null
        fi

        # Remove the manifest
        rm -f "$manifest"

        print_success "Successfully removed $pkg_name"
    done
}

# List command
cmd_list() {
    if [[ ! -d "$INSTALLED" ]]; then
        print_info "No packages installed"
        return 0
    fi

    local packages=("$INSTALLED"/*.txt)

    if [[ ! -e "${packages[0]}" ]]; then
        print_info "No packages installed"
        return 0
    fi

    echo -e "${YELLOW}Installed packages:${NC}"
    for manifest in "${packages[@]}"; do
        local pkg_name=$(basename "$manifest" .txt)
        echo -e "  ${GREEN}$pkg_name${NC}"
    done
}

# Load command (install from .ikeg JSON descriptor)
cmd_load() {
    if [[ $# -eq 0 ]]; then
        print_error "No .ikeg file specified"
        echo "Usage: $PROGRAM_NAME load <file.ikeg...>"
        return 1
    fi

    for ikegfile in "$@"; do
        # Check if file exists
        if [[ ! -f "$ikegfile" ]]; then
            print_error "File not found: $ikegfile"
            continue
        fi

        # Check if it's an .ikeg file
        if [[ "$ikegfile" != *.ikeg ]]; then
            print_warning "File does not have .ikeg extension: $ikegfile"
        fi

        print_info "Reading $ikegfile..."

        # Parse JSON and extract fields using a single python3 call
        # Outputs tab-separated: name\tversion\tauthor\tdescription\tdownload_url
        local parsed parse_err
        parsed=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    fields = ['name', 'version', 'author', 'description', 'download-url']
    print('\t'.join(str(d.get(f, '')) for f in fields))
except Exception as e:
    print('ERROR:' + str(e), file=sys.stderr)
    sys.exit(1)
" "$ikegfile" 2>&1)
        parse_err=$?

        if [[ $parse_err -ne 0 ]]; then
            print_error "Failed to parse JSON from $ikegfile"
            # Show the python error (prefixed with ERROR:)
            echo "$parsed" | grep '^ERROR:' | sed 's/^ERROR:/  /'
            continue
        fi

        # Read tab-separated fields into variables
        IFS=$'\t' read -r pkg_name pkg_version pkg_author pkg_description pkg_url <<< "$parsed"

        if [[ -z "$pkg_name" ]]; then
            print_error "Missing 'name' field in $ikegfile"
            continue
        fi

        if [[ -z "$pkg_url" ]]; then
            print_error "Missing 'download-url' field in $ikegfile"
            continue
        fi

        # Display package info
        echo ""
        echo -e "  ${GREEN}Package:${NC}        $pkg_name"
        [[ -n "$pkg_version" ]] && echo -e "  ${GREEN}Version:${NC}        $pkg_version"
        [[ -n "$pkg_author" ]] && echo -e "  ${GREEN}Author:${NC}         $pkg_author"
        [[ -n "$pkg_description" ]] && echo -e "  ${GREEN}Description:${NC}    $pkg_description"
        echo -e "  ${GREEN}Download URL:${NC}   $pkg_url"
        echo ""

        # Confirm installation
        # Skip prompt if AURO_SKIP_PROMPT is set (e.g. when called from cmd_repo/cmd_get non-interactively)
        if [[ -z "${AURO_SKIP_PROMPT:-}" ]]; then
            # Default is NO: an empty/EOF response skips the package instead of
            # auto-installing it, so a redirected or piped stdin can never push "Y".
            local skip=0
            while true; do
                echo -en "  ${YELLOW}Install $pkg_name? [y/N]: ${NC}"
                # Read from the controlling terminal so a redirected/piped stdin
                # cannot auto-advance the prompt.
                if [[ -r /dev/tty ]]; then
                    read -r confirm < /dev/tty
                    confirm_rc=$?
                else
                    read -r confirm
                    confirm_rc=$?
                fi
                if [[ $confirm_rc -ne 0 ]]; then
                    print_warning "No input received; skipping $pkg_name"
                    skip=1
                    break
                fi
                case "$confirm" in
                    [Yy]) break ;;
                    [Nn]|"") print_info "Skipping $pkg_name"; skip=1; break ;;
                    *) echo -e "  ${RED}Please answer y or n.${NC}" ;;
                esac
            done
            if [[ $skip -eq 1 ]]; then
                continue
            fi
        else
            print_info "Auto-confirming installation of $pkg_name (AURO_SKIP_PROMPT set)"
        fi

        # Download the .keg file
        local filename=$(basename "$pkg_url")
        local keg_path="/tmp/$filename"
        print_info "Downloading $pkg_url..."

        if ! wget -q "$pkg_url" -O "$keg_path"; then
            print_error "Failed to download $pkg_url"
            continue
        fi

        print_success "Successfully downloaded $filename"

        # Install the downloaded .keg
        cmd_install "$keg_path"

        # Cleanup temp file
        rm -f "$keg_path"
    done
}

# Repo base URL (no trailing slash)
REPO_BASE="http://aurorepo.runbsd.io/pkgs"

# Load configured repositories. The built-in default is always first.
load_repos() {
    printf '%s\t%s\n' "$DEFAULT_REPO_NAME" "$REPO_BASE"

    if [[ -f "$CONFIG_FILE" ]]; then
        while IFS=$'\t' read -r repo_name repo_url; do
            [[ -z "$repo_name" || "$repo_name" == "$DEFAULT_REPO_NAME" ]] && continue
            repo_url="${repo_url%/}"
            [[ "$repo_name" =~ ^[a-zA-Z0-9_-]+$ ]] || continue
            [[ "$repo_url" == http://* || "$repo_url" == https://* ]] || continue
            printf '%s\t%s\n' "$repo_name" "$repo_url"
        done < "$CONFIG_FILE"
    fi
}

# Add a repository
cmd_add_repo() {
    if [[ $# -ne 2 ]]; then
        print_error "Invalid arguments"
        echo "Usage: $PROGRAM_NAME add-repo <name> <url>"
        return 1
    fi

    local repo_name="$1"
    local repo_url="$2"

    if [[ ! "$repo_name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        print_error "Invalid repository name: $repo_name"
        return 1
    fi

    if [[ "$repo_name" == "$DEFAULT_REPO_NAME" ]]; then
        print_error "Repository name '$DEFAULT_REPO_NAME' is reserved"
        return 1
    fi

    repo_url="${repo_url%/}"
    if [[ "$repo_url" != http://* && "$repo_url" != https://* ]]; then
        print_error "Repository URL must start with http:// or https://"
        return 1
    fi

    if [[ -f "$CONFIG_FILE" ]] && awk -F '\t' -v name="$repo_name" '$1 == name {found=1} END {exit !found}' "$CONFIG_FILE"; then
        print_error "Repository '$repo_name' already exists"
        return 1
    fi

    printf '%s\t%s\n' "$repo_name" "$repo_url" >> "$CONFIG_FILE"
    print_success "Added repository '$repo_name'"
}

# Remove a repository
cmd_remove_repo() {
    if [[ $# -ne 1 ]]; then
        print_error "Invalid arguments"
        echo "Usage: $PROGRAM_NAME remove-repo <name>"
        return 1
    fi

    local repo_name="$1"

    if [[ "$repo_name" == "$DEFAULT_REPO_NAME" ]]; then
        print_error "The default repository cannot be removed"
        return 1
    fi

    if [[ ! -f "$CONFIG_FILE" ]]; then
        print_error "Repository '$repo_name' not found"
        return 1
    fi

    if ! awk -F '\t' -v name="$repo_name" '$1 == name {found=1} END {exit !found}' "$CONFIG_FILE"; then
        print_error "Repository '$repo_name' not found"
        return 1
    fi

    local tmp_file
    tmp_file=$(mktemp "${CONFIG_FILE}.tmp.XXXXXX")
    awk -F '\t' -v name="$repo_name" '$1 != name' "$CONFIG_FILE" > "$tmp_file"
    mv "$tmp_file" "$CONFIG_FILE"
    print_success "Removed repository '$repo_name'"
}

# Fix permissions on the .keg directory
cmd_fixperms() {
    if [[ $# -ne 0 ]]; then
        print_error "Invalid arguments"
        echo "Usage: $PROGRAM_NAME fixperms"
        return 1
    fi

    if [[ ! -d "$REAL_HOME/.keg" ]]; then
        print_error "No .keg directory found at $REAL_HOME/.keg"
        return 1
    fi

    local target_owner
    if [[ -n "$SUDO_USER" ]]; then
        target_owner="$SUDO_USER:$SUDO_USER"
    else
        target_owner="$USER:$USER"
    fi

    chown -R "$target_owner" "$REAL_HOME/.keg" 2>/dev/null || {
        print_warning "Could not change ownership of $REAL_HOME/.keg to $target_owner"
    }

    find "$REAL_HOME/.keg" -type d -exec chmod 755 {} + 2>/dev/null || true
    find "$REAL_HOME/.keg" -type f -exec chmod 644 {} + 2>/dev/null || true
    if [[ -d "$REAL_HOME/.keg/bin" ]]; then
        find "$REAL_HOME/.keg/bin" -type f -exec chmod +x {} + 2>/dev/null || true
    fi

    print_success "Fixed permissions on $REAL_HOME/.keg"
}

# Repo command (install from configured repositories)
cmd_repo() {
    if [[ $# -eq 0 ]]; then
        print_error "No package specified"
        echo "Usage: $PROGRAM_NAME repo <package...>"
        return 1
    fi

    local tmp_dir
    tmp_dir=$(mktemp -d)
    local repos_file="$tmp_dir/repositories.txt"

    load_repos > "$repos_file"

    print_info "Fetching package indexes..."
    while IFS=$'\t' read -r repo_name repo_url; do
        [[ -z "$repo_name" ]] && continue
        local index_file="$tmp_dir/$repo_name.list"
        if ! wget -q "$repo_url/pkgs.list" -O "$index_file" 2>/dev/null; then
            print_warning "Failed to fetch package index from $repo_name"
        fi
    done < "$repos_file"

    for pkg_name in "$@"; do
        local found=0
        while IFS=$'\t' read -r repo_name repo_url; do
            [[ -z "$repo_name" ]] && continue
            local index_file="$tmp_dir/$repo_name.list"
            [[ -f "$index_file" ]] || continue
            if grep -qxF "$pkg_name" "$index_file"; then
                local ikeg_url="$repo_url/$pkg_name.ikeg"
                local ikeg_file="/tmp/auro-repo-$pkg_name.ikeg"
                print_info "Found '$pkg_name' in repository '$repo_name'"
                print_info "Fetching $pkg_name.ikeg..."
                if ! wget -q "$ikeg_url" -O "$ikeg_file" 2>/dev/null; then
                    print_error "Failed to download $ikeg_url"
                    rm -f "$ikeg_file"
                    continue
                fi
                cmd_load "$ikeg_file"
                rm -f "$ikeg_file"
                found=1
                break
            fi
        done < "$repos_file"

        if [[ $found -eq 0 ]]; then
            print_error "Package '$pkg_name' not found in repository"
        fi
    done

    # When AURO_SKIP_PROMPT is set, each invoked cmd_load will skip the interactive prompt
    rm -rf "$tmp_dir"
}

# Get command (download and install)
cmd_get() {
    if [[ $# -eq 0 ]]; then
        print_error "No packages specified"
        echo "Usage: $PROGRAM_NAME get <url...>"
        return 1
    fi

    for package in "$@"; do
        print_info "Downloading $package..."

        # Get the filename from the URL
        local filename=$(basename "$package")

        if wget -q "$package" -O "/tmp/$filename"; then
            print_success "Successfully downloaded $filename"
            # Automatically install the downloaded .keg file
            cmd_install "/tmp/$filename"
        else
            print_error "Failed to download $package"
        fi
    done
}

# Ensure .keg directories and config are owned by the real user
fix_ownership() {
    if [[ -n "$SUDO_USER" ]]; then
        chown -R "$SUDO_USER:$SUDO_USER" "$REAL_HOME/.keg" 2>/dev/null || true
    fi
}

# Main command parser
main() {
    fix_ownership

    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        install)
            cmd_install "$@"
            ;;
        remove)
            cmd_remove "$@"
            ;;
        get)
            cmd_get "$@"
            ;;
        load)
            cmd_load "$@"
            ;;
        add-repo)
            cmd_add_repo "$@"
            ;;
        remove-repo)
            cmd_remove_repo "$@"
            ;;
        repo)
            cmd_repo "$@"
            ;;
        list)
            cmd_list
            ;;
        fixperms)
            cmd_fixperms "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        --version|-v)
            echo "$PROGRAM_NAME version $VERSION"
            ;;
        *)
            print_error "Unknown command: $command"
            echo "Run '$PROGRAM_NAME help' for usage information"
            exit 1
            ;;
    esac
}

main "$@"
